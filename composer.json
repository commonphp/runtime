{
  "name": "comphp/runtime",
  "license": "MIT",
  "require": {
    "php": "^8.5",
    "php-di/php-di": "^7.1",
    "symfony/dotenv": "^8.0",
    "psr/log": "^3.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^13.1",
    "friendsofphp/php-cs-fixer": "^3.95"
  },
  "autoload": {
    "files": [
      "helpers.php"
    ],
    "psr-4": {
      "CommonPHP\\Runtime\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "CommonPHP\\Runtime\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit --configuration phpunit.xml.dist",
    "cs:check": "php-cs-fixer fix --dry-run --diff --config=.php-cs-fixer.dist.php",
    "lint": "find src tests -name \"*.php\" -print0 | xargs -0 -n1 php -l"
  }
}